# CODReal Backend
APP_NAME=CODReal API
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the service_role key on the backend only (never expose to frontend)
SUPABASE_KEY=your-service-role-key
# Project Settings → API → JWT Secret (for local JWT validation)
SUPABASE_JWT_SECRET=your-jwt-secret

# Business defaults
DEFAULT_RETURN_FEE=25.0

# Token encryption (any long random string; defaults to JWT secret if empty)
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Frontend URL (OAuth redirect after Meta callback)
FRONTEND_URL=http://localhost:3000

# Meta Marketing API (read-only) — https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/meta/callback
META_GRAPH_VERSION=v21.0
META_OAUTH_SCOPES=ads_read,business_management
META_INSIGHTS_DATE_PRESET=last_30d

# TikTok Marketing API (read-only) — https://business-api.tiktok.com/
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8000/api/v1/integrations/tiktok/callback
TIKTOK_API_BASE=https://business-api.tiktok.com/open_api/v1.3

# Cron job secret (POST /api/v1/jobs/sync-ads)
CRON_SECRET=change-me-to-a-long-random-cron-secret
